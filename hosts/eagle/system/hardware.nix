# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot = {
    initrd.availableKernelModules = [
      "nvme"
      "xhci_pci"
      "thunderbolt"
      "usb_storage"
      "sd_mod"
      "sdhci_pci"
    ];
    initrd.kernelModules = [ ];
    kernelModules = [ "kvm-amd" ];
    extraModulePackages = [ ];
  };

  fileSystems."/" = {
    device = "/dev/mapper/luks-46c64a55-12ec-4dca-a2cb-9be9687559ee";
    fsType = "ext4";
  };

  boot.initrd.luks.devices."luks-46c64a55-12ec-4dca-a2cb-9be9687559ee".device =
    "/dev/disk/by-uuid/46c64a55-12ec-4dca-a2cb-9be9687559ee";

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/A276-D74F";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [
    {
      # Random-key encrypted swap: a fresh key is generated every boot, so the
      # partition needs no LUKS header/passphrase (and cannot be hibernated to).
      device = "/dev/disk/by-partuuid/7c43c4e2-b625-47d8-ba31-027d73ea79a7";
      randomEncryption.enable = true;
    }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
